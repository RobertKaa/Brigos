{
  "name": "brigo-club",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "ci:cloudflare": "npm test && npm run check && npm run build:cloudflare",
    "preview": "vite preview --host 127.0.0.1",
    "server:bundle": "node scripts/build-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html README.md",
    "check": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.3",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.0.0"
  }
