# Admin : uniquement avec npm run dev, sur localhost / 127.0.0.1 / [::1], en mode invité.
# Aucun paramètre d'environnement ne l'active dans un build de production.
# Ce panneau local n'est pas une authentification personnelle.

# Comptes Supabase : clés PUBLIQUES uniquement. Sans ces valeurs, le mode invité reste disponible.
# Ne jamais utiliser de clé secret/service_role ni de mot de passe dans VITE_*.
# Projet Brigos ; la clé vide ci-dessous laisse les comptes désactivés.
VITE_SUPABASE_URL=https://zqhnbygwxfqjtbfeuiyg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google reste masqué tant que le fournisseur n'est pas configuré dans Supabase.
VITE_AUTH_GOOGLE_ENABLED=false
# Redirection exacte à autoriser dans Supabase Auth et Google. En local :
VITE_AUTH_REDIRECT_URL=http://127.0.0.1:5173/#account
# GitHub Pages : /Brigos/ ; développement et Cloudflare sur brigoslab.com : /
VITE_BASE_PATH=/
